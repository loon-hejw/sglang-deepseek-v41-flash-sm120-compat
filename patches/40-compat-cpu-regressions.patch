+class Pointer:
+    def __init__(self,tensor,offset=0):self.tensor,self.offset=tensor,offset
+    def __add__(self,n):return Pointer(self.tensor,self.offset+n)
+
+
+class TL:
+    int64=torch.int64
+    program_id=staticmethod(lambda axis:0)
+    arange=staticmethod(torch.arange)
+    where=staticmethod(torch.where)
+    max=staticmethod(lambda x,axis:torch.max(x,dim=axis).values)
+    min=staticmethod(lambda x,axis:torch.min(x,dim=axis).values)
+    @staticmethod
+    def load(ptr,mask=None,other=0):
+        safe=torch.where(mask,ptr.offset,0) if mask is not None else ptr.offset
+        v=ptr.tensor[safe]
+        return torch.where(mask,v,other) if mask is not None else v
+    @staticmethod
+    def store(ptr,value):ptr.tensor[ptr.offset]=value

+@functools.cache
+def ordinary_info_type():
+    ns = load("python/sglang/srt/sampling/penaltylib/repetition_penalty.py", ["apply_scaling_penalties"])
+    names = ["_apply_pre_grammar_logits_transforms", "_apply_post_grammar_logits_transforms", "apply_logits_bias", "__len__"]
+    load("python/sglang/srt/sampling/sampling_batch_info.py", names, ns, "SamplingBatchInfo")
+    return type("Info", (NS,), {name: ns[name] for name in names})

+    value = ns["BatchedPenalizerOrchestrator"](8, batch, {ns[n] for n in ["BatchedFrequencyPenalizer", "BatchedPresencePenalizer", "BatchedRepetitionPenalizer", "BatchedMinNewTokensPenalizer"]})

+def assert_state(ns, o, histories):
+    freq = o.penalizers[ns["BatchedFrequencyPenalizer"]].cumulated_frequency_penalties
+    presence = o.penalizers[ns["BatchedPresencePenalizer"]].cumulated_presence_penalties
+    repeat = o.penalizers[ns["BatchedRepetitionPenalizer"]].cumulated_repetition_penalties
+    lengths = o.penalizers[ns["BatchedMinNewTokensPenalizer"]].len_output_tokens
+    expected = torch.zeros_like(freq)
+    for i, history in enumerate(histories):
+        for token in history: expected[i, token] += .5
+    torch.testing.assert_close(freq, expected)
+    torch.testing.assert_close(presence, torch.where(expected > 0, .2, 0.))
+    torch.testing.assert_close(repeat, torch.where(expected > 0, 1.5, 1.))
+    assert lengths.flatten().tolist() == [len(x) for x in histories]

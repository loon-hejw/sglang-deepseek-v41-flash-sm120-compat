+def info(bs, additive=None, scaling=None, bias=None, grammar=None, live=None):
+    return ordinary_info_type()(temperatures=torch.ones(bs), acc_additive_penalties=additive,
+                acc_scaling_penalties=scaling, logit_bias=bias, grammar_mask=grammar,
+                penalizer_orchestrator=live, has_custom_logit_processor=False,
+                is_all_greedy=True, sampling_mask_batch_indices=None)
+
+
+class Mask:
+    def __init__(self, mask): self.vocab_mask, self.grammar = mask, self
+    def apply(self, logits): self.apply_vocab_mask(logits=logits, vocab_mask=self.vocab_mask)
+    def apply_vocab_mask(self, *, logits, vocab_mask): logits.masked_fill_(~vocab_mask, -float("inf"))

@@ -1560,6 +1560,103 @@ class DeepSeekV41ReasoningDetector(DeepSeekV4Detector):
     def __init__(self, **kwargs):
         super().__init__(**kwargs)
         self.tool_start_token = f"<{dsv4_dsml_token} calls>"
+        self._v41_tool_starts = (
+            self.tool_start_token,
+            f"<{dsv4_dsml_token} invoke ",
+        )
+        self._v41_tool_pattern = re.compile(
+            rf"<{re.escape(dsv4_dsml_token)} (?:calls>|invoke(?=\s))"
+        )
+        self._v41_pending = ""
+        self._v41_previous_char = ""
+        self._v41_in_tools = False
+        if self.continue_final_message and self.previous_content:
+            # A literal think marker in a continued tool parameter must not
+            # re-open reasoning. Scan history without emitting it again.
+            history = type(self)(
+                force_reasoning=self.force_reasoning,
+                stream_reasoning=self.stream_reasoning,
+            )
+            history._parse_streaming_increment_impl(self.previous_content)
+            self._v41_in_tools = history._v41_in_tools
+            self._v41_previous_char = self.previous_content[-1]
+            if self._v41_in_tools:
+                self._in_reasoning = False
+
+    def _parse_streaming_increment_impl(self, new_text: str) -> StreamingParseResult:
+        if self._v41_in_tools:
+            return StreamingParseResult(normal_text=new_text)
+
+        self._v41_pending += new_text
+        normal = []
+        reasoning = []
+
+        def feed_prefix(text):
+            if not text:
+                return
+            result = super(
+                DeepSeekV41ReasoningDetector, self
+            )._parse_streaming_increment_impl(text)
+            normal.append(result.normal_text)
+            reasoning.append(result.reasoning_text)
+            self._v41_previous_char = text[-1]
+
+        while match := self._v41_tool_pattern.search(self._v41_pending):
+            feed_prefix(self._v41_pending[: match.start()])
+            # While thinking, only a line-start DSML boundary closes that
+            # block. Outside thinking, preserve the tool parser's acceptance
+            # of calls immediately after prose or a closing think marker.
+            if not self._in_reasoning or self._v41_previous_char in ("", "\n"):
+                if self._in_reasoning:
+                    reasoning.append(self._strip_leading_think_start(self._buffer))
+                else:
+                    normal.append(self._buffer)
+                self._buffer = ""
+                self._in_reasoning = False
+                self._v41_in_tools = True
+                normal.append(self._v41_pending[match.start() :])
+                self._v41_pending = ""
+                return StreamingParseResult(
+                    normal_text="".join(normal), reasoning_text="".join(reasoning)
+                )
+            # A mid-sentence mention inside reasoning is not a tool call.
+            feed_prefix(match.group())
+            self._v41_pending = self._v41_pending[match.end() :]
+
+        # Hold only the suffix that could become a tool boundary. This must
+        # happen before the shared parser sees literal think tags in a tool
+        # body, including when the boundary and body arrive in one chunk.
+        holdback = max(
+            self._ends_with_partial_token(self._v41_pending, token)
+            for token in self._v41_tool_starts
+        )
+        size = len(self._v41_pending) - holdback
+        feed_prefix(self._v41_pending[:size])
+        self._v41_pending = self._v41_pending[size:]
+        return StreamingParseResult(
+            normal_text="".join(normal), reasoning_text="".join(reasoning)
+        )
+
+    def finish(self) -> StreamingParseResult:
+        result = StreamingParseResult()
+        if self._v41_pending:
+            result = super()._parse_streaming_increment_impl(self._v41_pending)
+            self._v41_pending = ""
+        tail = super().finish()
+        return StreamingParseResult(
+            normal_text=result.normal_text + tail.normal_text,
+            reasoning_text=result.reasoning_text + tail.reasoning_text,
+        )
+
+    def _detect_and_parse_impl(self, text: str) -> StreamingParseResult:
+        # Use the same boundary ordering as streaming: a literal </think>
+        # inside a tool parameter cannot close the earlier reasoning block.
+        result = self._parse_streaming_increment_impl(text)
+        tail = self.finish()
+        return StreamingParseResult(
+            normal_text=result.normal_text + tail.normal_text,
+            reasoning_text=result.reasoning_text + tail.reasoning_text,
+        )
 
 

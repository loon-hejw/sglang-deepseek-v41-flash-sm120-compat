+@pytest.mark.parametrize("case", ["none", "add", "scale", "bias", "combined", "grammar", "all"])
+def test_verify_matches_ordered_sampling(sampling, bs, width, dtype, case):
+    base = torch.tensor([0.25, -0.25, 2., -2., 0.], dtype=dtype).repeat(bs * width, 1)
+    add = torch.tensor([[-1., 1., -.5, .5, 0.]]).repeat(bs, 1) if case in {"add", "combined", "all"} else None
+    scale = torch.tensor([[1.3, 2., .8, 1.5, 1.]]).repeat(bs, 1) if case in {"scale", "combined", "all"} else None
+    bias = torch.tensor([[.1, -.1, .5, .2, 0.]]).repeat(bs, 1) if case in {"bias", "combined", "all"} else None
+    mask = Mask(torch.tensor([[True, True, False, True, False]]).repeat(bs, 1)) if case in {"grammar", "all"} else None
+    expected = base.clone()
+    if add is not None: expected.add_(add.repeat_interleave(width, dim=0))
+    if scale is not None: sampling["apply_scaling_penalties"](expected, scale.repeat_interleave(width, dim=0))
+    if mask: mask.apply_vocab_mask(logits=expected, vocab_mask=mask.vocab_mask.repeat_interleave(width, dim=0))
+    if bias is not None: expected.add_(bias.repeat_interleave(width, dim=0))
+    si = info(bs, add, scale, bias, mask)
+    sampling["apply_dflash_verify_logits_adjustments"](next_token_logits=base, sampling_info=si, draft_token_num=width)
+    torch.testing.assert_close(base, expected, rtol=0, atol=0)
+    assert sampling["verify_logits_adjustments_are_noop"](si) == (case == "none")
+    worker = NS(_selector_sample=None)
+    assert sampling["_can_skip_verify_logits"](worker, NS(has_grammar=bool(mask), return_logprob=False), si) == (case == "none")

+class TestDeepSeekV41LiteralThinkRoundTrip(TestDeepSeekV41RoundTrip):
+    """Exercise the installed ReasoningParser -> FunctionCallParser pipeline."""
+
+    def test_literals_without_a_leading_thinking_block(self):
+        for value in ("<think>literal</think>", "<think>", "</think>", '中文 "引号"\n<think>一</think>'):
+            completion = self.completion[self.completion.index(f"<{DSML} calls>") :]
+            completion = completion.replace(self.ARGUMENTS["query"], value)
+            expected = [("lookup", {**self.ARGUMENTS, "query": value})]
+            with self.subTest(value=value, mode="nonstream"):
+                reason, text = ReasoningParser("deepseek-v41", force_reasoning=False).parse_non_stream(completion)
+                self.assertFalse(reason)
+                _, calls = FunctionCallParser(self.tools, "deepseekv41").parse_non_stream(text)
+                self.assertEqual([(c.name, json.loads(c.parameters)) for c in calls], expected)
+            for size in CHUNK_SIZES:
+                with self.subTest(value=value, chunk_size=size):
+                    reasoning = ReasoningParser("deepseek-v41", force_reasoning=False)
+                    tools = FunctionCallParser(self.tools, "deepseekv41")
+                    results = [reasoning.parse_stream_chunk(completion[i:i+size]) for i in range(0,len(completion),size)]
+                    results.append(reasoning.parse_stream_end())
+                    self.assertFalse("".join(reason or "" for reason, _ in results))
+                    calls = []
+                    for _, text in results:
+                        _, delta = tools.parse_stream_chunk(text or "")
+                        calls.extend(delta)
+                    _, delta = tools.parse_stream_end()
+                    calls.extend(delta)
+                    self.assertEqual(_assemble(calls), expected)
+

+@pytest.fixture(scope="module")
+def v41_reasoning():
+    ns = dict(dsv4_thinking_start_token="<think>", dsv4_thinking_end_token="</think>",
+              dsv4_dsml_token="｜DSML｜", dsv4_eos_token="<｜end▁of▁sentence｜>")
+    return load("python/sglang/srt/parser/reasoning_parser.py", ["StreamingParseResult",
+        "BaseReasoningFormatDetector", "DeepSeekV4Detector", "DeepSeekV41ReasoningDetector"], ns)["DeepSeekV41ReasoningDetector"]
+
+
+def literal_call(value, bare=False):
+    invoke = '<｜DSML｜ invoke name="probe"><｜DSML｜ parameter name="text" string="true">'+value+'</｜DSML｜ parameter></｜DSML｜ invoke>'
+    return invoke if bare else '<｜DSML｜ calls>'+invoke+'</｜DSML｜ calls>'
+
+
+@pytest.mark.parametrize("value", ["<think>literal</think>", "<think>", "</think>", "<th",
+    '中文 "引号"\n<think>一</think>\t<think>二</think>', "before </thi"])
+@pytest.mark.parametrize("prefix,forced,want_reason,want_prose", [
+    ("", False, "", ""), ("summary\n\n", False, "", "summary\n\n"),
+    ("<think>reason</think>\n\n", False, "reason", "\n\n"),
+    ("reason\n\n", True, "reason\n\n", ""),
+    ("<think>mention <｜DSML｜ calls> here</think>\n\n", False, "mention <｜DSML｜ calls> here", "\n\n"),
+    ("<think>reason</think>", False, "reason", "")])
+@pytest.mark.parametrize("stream_reasoning", [True, False])
+@pytest.mark.parametrize("bare", [False, True])
+def test_v41_literal_tool_pipeline(v41_reasoning, detectors, value, prefix, forced, want_reason, want_prose, stream_reasoning, bare):
+    raw = literal_call(value, bare)
+    text = prefix + raw
+    tools = [NS(function=NS(name="probe"))]
+    for size in [1, 2, 3, 7, len(text)]:
+        parser = v41_reasoning(force_reasoning=forced, stream_reasoning=stream_reasoning)
+        result = [parser.parse_streaming_increment(text[i:i+size]) for i in range(0,len(text),size)] + [parser.finish()]
+        assert ''.join(r.reasoning_text for r in result) == want_reason
+        assert ''.join(r.normal_text for r in result) == want_prose + raw
+        tool_parser = detectors['DeepSeekV41Detector']()
+        calls = [c for r in result for c in tool_parser.parse_streaming_increment(r.normal_text, tools).calls]
+        calls += tool_parser.finish(tools).calls
+        assert len(calls) == 1
+        assert json.loads(calls[0].parameters) == {"text": value}
+    result = v41_reasoning(force_reasoning=forced, stream_reasoning=stream_reasoning).detect_and_parse(text)
+    assert (result.reasoning_text, result.normal_text) == (want_reason, want_prose + raw)
+    calls = detectors['DeepSeekV41Detector']().detect_and_parse(result.normal_text,tools).calls
+    assert len(calls) == 1 and json.loads(calls[0].parameters) == {"text": value}
+
+
+@pytest.mark.parametrize("stream_reasoning", [True,False])
+def test_v41_every_single_split_and_tool_continuation(v41_reasoning, stream_reasoning):
+    raw = literal_call('中文 <think>literal</think>')
+    text = '<think>reason</think>\n\n'+raw
+    for index in range(len(text)+1):
+        parser = v41_reasoning(stream_reasoning=stream_reasoning)
+        out = [parser.parse_streaming_increment(text[:index]),parser.parse_streaming_increment(text[index:]),parser.finish()]
+        assert ''.join(r.reasoning_text for r in out)=='reason'
+        assert ''.join(r.normal_text for r in out)=='\n\n'+raw
+    for prefix in ['', '<think>reason</think>\n\n']:
+        previous = prefix + raw[:raw.index('literal')]
+        tail = raw[raw.index('literal'):]
+        parser = v41_reasoning(continue_final_message=True,previous_content=previous,stream_reasoning=stream_reasoning)
+        out = [parser.parse_streaming_increment(c) for c in tail]+[parser.finish()]
+        assert ''.join(r.reasoning_text for r in out)==''
+        assert ''.join(r.normal_text for r in out)==tail
+
+
+def test_v41_truncated_tools_remain_unexecutable(v41_reasoning, detectors):
